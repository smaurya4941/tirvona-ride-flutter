<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is backed up to Google Drive or copied by a
     device-to-device transfer. Sign-in tokens live in the Android Keystore
     (flutter_secure_storage), whose keys do not travel to another phone, so a
     restored copy would only crash on decrypt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
